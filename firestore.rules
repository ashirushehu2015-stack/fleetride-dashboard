rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if isValidId(driverId);
    }

    // Passengers collection
    match /passengers/{passengerId} {
      allow read: if true;
      allow write: if isValidId(passengerId);
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if true;
      allow write: if isValidId(tripId);
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if true;
      allow write: if isValidId(feedbackId);
    }
  }
}
